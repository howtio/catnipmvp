DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_GATEWAY_API_KEY=your_ai_gateway_api_key
AI_GATEWAY_MODEL=deepseek/deepseek-v3.2
CATNIP_RUNNER_PROVIDER=auto
CATNIP_RUNNER_MAX_STEPS=5
CATNIP_RUNNER_MAX_TOOL_RETRIES=0
CATNIP_RUNNER_CONTINUE_ON_TOOL_ERROR=0
CATNIP_RUN_TIMEOUT_MS=60000
CATNIP_CLI_DEBUG=0
CATNIP_WORKER_COUNT=1
CATNIP_WORKER_HEARTBEAT_MS=1000
CATNIP_WORKSPACE_ROOT=./workspaces/demo
